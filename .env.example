# Public site URL, without a trailing slash.
# Used for canonical links, Open Graph tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form transport. Any endpoint that accepts a JSON POST with
# { name, email, message, website } works — e.g. Resend, Web3Forms, or a
# small serverless function. Leave empty to keep the form in dev-only mode.
CONTACT_FORM_ENDPOINT=
