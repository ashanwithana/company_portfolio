# Public site URL, without a trailing slash.
# Used for canonical links, Open Graph tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form transport (EmailJS).
# Get these from https://dashboard.emailjs.com — Service ID and Template ID
# from your EmailJS service/template, Public Key from Account → General,
# Private Key from Account → General (required for server-side sending).
# The template itself lives in emails/enquiry-template.html — paste it into
# your EmailJS template's content editor.
EMAILJS_PRIVATE_KEY=xiDqlwN3Q38n0OImmgvJS
EMAILJS_SERVICE_ID=service_nsut2z9
EMAILJS_TEMPLATE_ID=template_rjpccr6
